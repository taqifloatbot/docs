{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dashboard API",
  "colors": {
    "primary": "#f46177",
    "light": "#f46177",
    "dark": "#f46177"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Campaign API",
            "pages": [
              "api-reference/campaign/create",
              "api-reference/campaign/get",
              "api-reference/campaign/update",
              "api-reference/campaign/archive",
              "api-reference/campaign/contacts"
            ]
          },
          {
            "group": "Contacts API",
            "pages": [
              "api-reference/contacts/list",
              "api-reference/contacts/create",
              "api-reference/contacts/get",
              "api-reference/contacts/update",
              "api-reference/contacts/upload"
            ]
          },
          {
            "group": "Analytics & Integration",
            "pages": [
              "api-reference/analytics",
              "api-reference/webhooks"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.floatbot.ai",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://floatbot.ai/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/image.png",
    "dark": "/logo/image.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@floatbot.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://floatbot.ai/login"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/example",
      "github": "https://github.com/example",
      "linkedin": "https://linkedin.com/company/example"
    }
  }
}
